# Server-side only. Never expose these values in client-side VITE_* variables.
MASSIVE_API_KEY=replace_with_your_massive_api_key

# Required only for protected batch endpoints (/api/universe and /api/grouped).
# Generate a long random value and store it only in Vercel server environment variables.
ATLAS_BATCH_TOKEN=replace_with_a_long_random_token
